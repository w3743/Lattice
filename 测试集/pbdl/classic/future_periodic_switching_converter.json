{
  "name": "future_periodic_switching_converter",
  "description": "开关变换器：周期稳态纹波和开关应力",
  "ports": [
    {
      "name": "input",
      "role": "input",
      "terminals": [
        {
          "name": "in",
          "quantity": "voltage"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
    },
    {
      "name": "output",
      "role": "output",
      "terminals": [
        {
          "name": "out",
          "quantity": "voltage"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
    },
    {
      "name": "supply",
      "role": "power",
      "terminals": [
        {
          "name": "vcc",
          "quantity": "voltage"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
    }
  ],
  "analyses": [
    {
      "kind": "periodic_steady_state",
      "domain": "time_domain",
      "source_port": "input",
      "output_port": "output"
    }
  ],
  "targets": [
    {
      "target_kind": "dc",
      "input_voltage_v": 5.0,
      "output_voltage_v": 2.5,
      "tolerance": {
        "relative": 0.01
      }
    }
  ],
  "constraints": {
    "element_types": [
      "R",
      "C",
      "L",
      "opamp",
      "ideal_switch"
    ],
    "parameter_ranges": {
      "R": [
        10.0,
        10000000.0
      ],
      "C": [
        1e-12,
        0.001
      ],
      "L": [
        1e-09,
        1.0
      ]
    },
    "max_component_count": 16
  },
  "operating_point": {
    "supply_voltage_v": 5.0,
    "temperature_c": 25.0
  }
}
