{
  "name": "ac_tia_10kohm",
  "description": "光电流跨阻：10 kohm、10 Hz 至 100 kHz",
  "ports": [
    {
      "name": "current_input",
      "role": "input",
      "terminals": [
        {
          "name": "iin",
          "quantity": "current"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
    },
    {
      "name": "voltage_output",
      "role": "output",
      "terminals": [
        {
          "name": "out",
          "quantity": "voltage"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
    }
  ],
  "analyses": [
    {
      "kind": "voltage_transfer",
      "source_port": "current_input",
      "output_port": "voltage_output",
      "frequency_hz": [
        1.0,
        1000000.0,
        64
      ]
    }
  ],
  "targets": [
    {
      "target_kind": "amplifier",
      "gain_db": 80.0,
      "bandwidth_hz": [
        10.0,
        100000.0
      ],
      "tolerance": {
        "absolute": 1.0
      }
    }
  ],
  "constraints": {
    "element_types": [
      "R",
      "C",
      "opamp"
    ],
    "parameter_ranges": {
      "R": [
        10.0,
        10000000.0
      ],
      "C": [
        1e-12,
        0.001
      ],
      "L": [
        1e-09,
        1.0
      ]
    },
    "max_component_count": 10
  },
  "operating_point": {
    "supply_voltage_v": 5.0,
    "temperature_c": 25.0
  },
  "optimization": {
    "points": 64,
    "max_iterations": 10,
    "top_k": 1,
    "seed": 19
  }
}
