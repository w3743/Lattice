{
  "name": "ac_chebyshev_lowpass_10khz",
  "description": "选择性滤波：10 kHz 二阶 Chebyshev 低通",
  "ports": [
    {
      "name": "input",
      "role": "input",
      "terminals": [
        {
          "name": "in",
          "quantity": "voltage"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
    },
    {
      "name": "output",
      "role": "output",
      "terminals": [
        {
          "name": "out",
          "quantity": "voltage"
        },
        {
          "name": "0",
          "quantity": "ground"
        }
      ]
