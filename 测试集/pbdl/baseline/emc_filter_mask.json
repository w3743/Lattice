{
  "name": "emc_filter_mask",
  "description": "EMC 传导发射限值掩码：150kHz 以上每 decade -40dB 衰减",
  "ports": [
    {
      "name": "input",
      "terminals": [
        {"name": "in", "quantity": "voltage"},
        {"name": "0", "quantity": "ground"}
      ]
    },
    {
      "name": "output",
      "terminals": [
        {"name": "out", "quantity": "voltage"},
        {"name": "0", "quantity": "ground"}
      ]
    }
  ],
  "analyses": [
    {
      "kind": "voltage_transfer",
      "source_port": "input",
      "output_port": "output",
      "frequency_hz": [1000.0, 30000000.0, 200]
    }
  ],
  "targets": [
    {
      "target_kind": "mask",
      "frequency_hz":    [1000.0, 10000.0, 100000.0, 1000000.0, 10000000.0],
      "lower_bound_db":  [-100.0, -100.0,  -100.0,   -100.0,     -100.0],
      "upper_bound_db":  [0.0,    0.0,     -20.0,    -60.0,      -100.0],
      "weight": 1.0
    }
  ],
  "constraints": {
    "element_types": ["R", "C", "L"],
    "parameter_ranges": {
      "R": [0.1, 10000.0],
      "C": [1e-12, 1e-3],
      "L": [1e-9, 1e-1]
    },
    "max_component_count": 10
  },
  "operating_point": {}
}
