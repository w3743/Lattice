{
  "name": "bandpass_10khz",
  "description": "带通滤波器，中心 10kHz，Q=5，允许 RLC 和运放",
  "ports": [
    {
      "name": "input",
      "terminals": [
        {"name": "in", "quantity": "voltage"},
        {"name": "0", "quantity": "ground"}
      ]
    },
    {
      "name": "output",
      "terminals": [
        {"name": "out", "quantity": "voltage"},
        {"name": "0", "quantity": "ground"}
      ]
    }
  ],
  "analyses": [
    {
      "kind": "voltage_transfer",
      "source_port": "input",
      "output_port": "output",
      "frequency_hz": [100.0, 1000000.0, 200]
    }
  ],
  "targets": [
    {
      "target_kind": "filter",
      "filter_kind": "bandpass",
      "order": 2,
      "cutoff_hz": 10000.0,
      "q": 5.0,
      "gain_db": 0.0,
      "response": "butterworth",
      "weight": 1.0
    }
  ],
  "constraints": {
    "element_types": ["R", "C", "L", "opamp"],
    "parameter_ranges": {
      "R": [1.0, 10000000.0],
      "C": [1e-12, 1e-2],
      "L": [1e-9, 10.0]
    },
    "max_component_count": 6
  },
  "operating_point": {}
}
