{
  "name": "one_khz_lowpass_robust",
  "ports": 2,
  "behavior": {
    "kind": "lowpass",
    "cutoff_hz": 1000,
    "gain": 1.0,
    "order": 1,
    "frequency_range_hz": [10, 100000]
  },
  "library": {
    "allowed": ["R", "C", "opamp"],
    "parameter_ranges": {
      "R": [100, 1000000],
      "C": [1e-10, 1e-4]
    }
  },
  "optimization": {
    "points": 120,
    "max_components": 5,
    "top_k": 3,
    "max_iterations": 50,
    "seed": 11,
    "robustness": {
      "enabled": true,
      "tolerance_fraction": 0.05,
      "samples": 80,
      "acceptance_rmse_db": 1.0,
      "acceptance_max_abs_db": 6.0,
      "score_weight": 0.25
    }
  }
}
